# 发布目标配置 —— 复制为 deploy/.env 后填写你自己的服务器（.env 已被 .gitignore 忽略）
# 例：DEPLOY_HOST=203.0.113.10   DEPLOY_DOMAIN=blog.example.com
DEPLOY_HOST=
DEPLOY_USER=root
DEPLOY_PORT=22
DEPLOY_PATH=/var/www/blog
DEPLOY_DOMAIN=
# 可选：自定义私钥路径，留空则使用 ~/.ssh/id_ed25519
# DEPLOY_SSH_KEY=

# 可选：把 deploy/nginx.conf.template 渲染后同步到服务器（默认关，避免覆盖 certbot 写入的 SSL 段）
# DEPLOY_SYNC_NGINX=0
# DEPLOY_NGINX_CONF=/etc/nginx/conf.d/blog.example.com.conf
# DEPLOY_FORCE_NGINX=1   # 目标配置已含 certbot SSL 段时，仍强制覆盖
